#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

CONFIG_REPOSITORY="$(python3 "$SCRIPT_DIR/configs-repo")"
cd "$CONFIG_REPOSITORY"

git pull

./init.sh

zsh -c 'source "$HOME/.zgen/zgen.zsh"; zgen selfupdate'
zsh -c 'source "$HOME/.zgen/zgen.zsh"; zgen update'

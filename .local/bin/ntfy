#!/usr/bin/env bash

set -uo pipefail

usage() {
  echo "Usage: ntfy <title> <body> <tags>" >&2
  echo "Set NTFY_IDLE_THRESHOLD_SECONDS (default: 120) to control activity suppression." >&2
}

debug() {
  if [ "${NTFY_DEBUG:-0}" = "1" ]; then
    echo "ntfy: $*" >&2
  fi
}

ring_terminal_bell() {
  # Prefer the controlling terminal so the bell remains audible when stdout is
  # captured by a caller such as Codex.
  if [ -e /dev/tty ]; then
    { printf '\a' > /dev/tty; } 2>/dev/null || true
  fi
}

linux_idle_seconds() {
  local result idle_milliseconds

  command -v gdbus >/dev/null 2>&1 || return 1
  result=$(gdbus call --session \
    --dest org.gnome.Mutter.IdleMonitor \
    --object-path /org/gnome/Mutter/IdleMonitor/Core \
    --method org.gnome.Mutter.IdleMonitor.GetIdletime 2>/dev/null) || return 1

  if [[ "$result" =~ ([0-9]+),?\) ]]; then
    idle_milliseconds=${BASH_REMATCH[1]}
    printf '%s\n' "$((idle_milliseconds / 1000))"
    return 0
  fi

  return 1
}

macos_idle_seconds() {
  local result idle_nanoseconds

  command -v ioreg >/dev/null 2>&1 || return 1
  result=$(ioreg -c IOHIDSystem 2>/dev/null) || return 1

  if [[ "$result" =~ \"HIDIdleTime\"[[:space:]]*=[[:space:]]*([0-9]+) ]]; then
    idle_nanoseconds=${BASH_REMATCH[1]}
    printf '%s\n' "$((idle_nanoseconds / 1000000000))"
    return 0
  fi

  return 1
}

idle_seconds() {
  case "$(uname -s)" in
    Linux) linux_idle_seconds ;;
    Darwin) macos_idle_seconds ;;
    *) return 1 ;;
  esac
}

if [ "$#" -ne 3 ]; then
  usage
  exit 1
fi

title=$1
body=$2
tags=$3
server_url=${NTFY_URL:-https://ntfy.sh}
idle_threshold=${NTFY_IDLE_THRESHOLD_SECONDS:-120}

if [ -z "${NTFY_TOPIC:-}" ]; then
  echo "ntfy: NTFY_TOPIC is not set" >&2
  exit 1
fi

if ! [[ "$idle_threshold" =~ ^[0-9]+$ ]]; then
  echo "ntfy: NTFY_IDLE_THRESHOLD_SECONDS must be a non-negative integer" >&2
  exit 1
fi

ring_terminal_bell

if current_idle_seconds=$(idle_seconds); then
  if [[ "$current_idle_seconds" =~ ^[0-9]+$ ]] && (( current_idle_seconds < idle_threshold )); then
    debug "suppressing push after ${current_idle_seconds}s idle (threshold: ${idle_threshold}s)"
    exit 0
  fi

  if ! [[ "$current_idle_seconds" =~ ^[0-9]+$ ]]; then
    debug "idle-time probe returned an invalid value; sending notification"
  fi
else
  debug "idle-time probe unavailable; sending notification"
fi

curl --fail --silent --show-error \
  --output /dev/null \
  -H "Title: $title" \
  -H "Tags: $tags" \
  --data-binary "$body" \
  "${server_url%/}/${NTFY_TOPIC}"

#!/usr/bin/env python3
"""Preview, apply, update, export, and import this repository's tracked configuration files."""

import argparse
import contextlib
import difflib
import fcntl
import fnmatch
import gzip
import hashlib
import io
import json
import os
from pathlib import Path, PurePosixPath
import posixpath
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import urllib.parse
import urllib.request
import zlib


REPOSITORY_ONLY = {
    ".gitignore", ".gitattributes", ".gitmodules", ".github",
    "AGENTS.md", "README.md", "Brewfile", "Brewfile.lock.json",
    "init.sh", "tests", "docs", "__pycache__",
}
STATE_PATH = ".local/state/configs/state.json"
COMMAND_PATH = ".local/bin/configs"
EXPORT_ROOT = "configs-export"
EXPORT_FORMAT = 1
DEFAULT_ARCHIVE = "configs-export.tar.gz"
DEFAULT_PLATFORMS = ("linux-x86_64", "linux-aarch64", "darwin-arm64", "darwin-x86_64")
GITSTATUS_URL = "https://github.com/romkatv/gitstatus/releases/download/{version}/{file}.tar.gz"


class SyncError(Exception):
    pass


def digest(contents):
    return hashlib.sha256(contents).hexdigest()


def valid_relative(path):
    return (isinstance(path, str) and bool(path)
            and not PurePosixPath(path).is_absolute()
            and all(part not in ("", ".", "..") for part in path.split("/")))


def check_parents(root, relative):
    """Never follow a link inside a source or destination tree."""
    current = root
    for part in PurePosixPath(relative).parts[:-1]:
        current = current / part
        if current.is_symlink():
            raise SyncError("symlinked parent directory: {}".format(current))
        if current.exists() and not current.is_dir():
            raise SyncError("parent is not a directory: {}".format(current))


def inspect(root, relative):
    check_parents(root, relative)
    path = root / relative
    try:
        info = path.lstat()
    except FileNotFoundError:
        return {"kind": "missing"}, None
    if stat.S_ISLNK(info.st_mode):
        return {"kind": "link", "target": os.readlink(path)}, None
    if not stat.S_ISREG(info.st_mode):
        raise SyncError("not a regular file: {}".format(path))
    mode = stat.S_IMODE(info.st_mode)
    if mode & 0o7000:
        raise SyncError("special permission bits are unsupported: {}".format(path))
    contents = path.read_bytes()
    return {"kind": "file", "sha256": digest(contents), "mode": mode}, contents


def file_record(snapshot):
    return {key: snapshot[key] for key in ("sha256", "mode")}


def load_state(target):
    snapshot, contents = inspect(target, STATE_PATH)
    if snapshot["kind"] == "missing":
        return {"version": 1, "repository": "", "files": {}}
    if snapshot["kind"] != "file":
        raise SyncError("installation state must be a regular file")
    try:
        state = json.loads(contents)
        if (not isinstance(state, dict) or type(state.get("version")) is not int or state["version"] != 1
                or not isinstance(state.get("repository"), str)
                or not Path(state["repository"]).is_absolute()
                or not isinstance(state.get("files"), dict)):
            raise ValueError("invalid schema or unsupported version")
        for relative, record in state["files"].items():
            if (not valid_relative(relative) or not isinstance(record, dict)
                    or set(record) != {"sha256", "mode"}
                    or not isinstance(record["sha256"], str)
                    or len(record["sha256"]) != 64
                    or any(char not in "0123456789abcdef" for char in record["sha256"])
                    or type(record["mode"]) is not int
                    or not 0 <= record["mode"] <= 0o777):
                raise ValueError("invalid file record")
        return state
    except (ValueError, TypeError, UnicodeError) as error:
        raise SyncError("invalid installation state: {}".format(error)) from error


def is_installable(relative):
    """Exclude repository support paths only at the root of the checkout."""
    return relative.split("/", 1)[0] not in REPOSITORY_ONLY


def tracked_sources(repository, include_deleted=False):
    result = subprocess.run(
        ["git", "-C", str(repository), "ls-files", "--stage", "-z"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True,
    )
    for entry in result.stdout.split(b"\0"):
        if not entry:
            continue
        metadata, raw_path = entry.split(b"\t", 1)
        mode, _, stage = metadata.split()
        relative = os.fsdecode(raw_path)
        if not is_installable(relative):
            continue
        if not valid_relative(relative) or stage != b"0" or mode not in (b"100644", b"100755"):
            raise SyncError("unsupported or unmerged tracked configuration: {}".format(relative))
        check_parents(repository, relative)
        if include_deleted or os.path.lexists(repository / relative):
            yield relative


def show_checkout_changes(repository):
    for relative in tracked_sources(repository, include_deleted=True):
        if not os.path.lexists(repository / relative):
            print("CHECKOUT DELETED {} (excluded from installation)".format(relative))
    result = subprocess.run(
        ["git", "-C", str(repository), "ls-files", "--others", "--exclude-standard", "-z"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True,
    )
    for raw_path in result.stdout.split(b"\0"):
        relative = os.fsdecode(raw_path)
        if (relative and is_installable(relative)
                and not (repository / relative).is_symlink() and (repository / relative).is_file()):
            print("UNTRACKED {} (not installed); run git add -- {}".format(relative, shlex.quote(relative)))


def install_mode(source_mode, current_mode):
    # Never add read/write access to an existing file. An executable source can
    # add execute permission only to classes that can already read that file.
    allowed = current_mode | ((current_mode & 0o444) >> 2)
    return source_mode & allowed


def make_plan(repository, target, state):
    operations = []
    conflicts = []
    destinations = set()
    sources = list(tracked_sources(repository))
    if COMMAND_PATH not in sources or not (repository / COMMAND_PATH).is_file() or (repository / COMMAND_PATH).is_symlink():
        raise SyncError("the installer requires a tracked .local/bin/configs; "
                        "run git add .local/bin/configs before applying")
    for relative in sources:
        destination = relative
        if destination in destinations:
            raise SyncError("multiple sources target {}".format(destination))
        destination_parts = PurePosixPath(destination)
        if any(destination_parts in PurePosixPath(other).parents
               or PurePosixPath(other) in destination_parts.parents for other in destinations):
            raise SyncError("file and directory destinations overlap: {}".format(destination))
        destinations.add(destination)
        try:
            destination_path = target / destination
            state_directory = (target / STATE_PATH).parent
            if (destination_path == state_directory or state_directory in destination_path.parents
                    or destination_path in state_directory.parents):
                raise SyncError("destination overlaps installation state: {}".format(destination))
            if target / destination == repository or repository in (target / destination).parents:
                raise SyncError("destination overlaps the repository: {}".format(destination))
            source, contents = inspect(repository, relative)
            if source["kind"] != "file":
                raise SyncError("tracked source is missing or symlinked: {}".format(relative))
            current, old_contents = inspect(target, destination)
            previous = state["files"].get(destination)
            mode = source["mode"]
            if current["kind"] == "file":
                baseline_mode = previous["mode"] if previous is not None else current["mode"]
                mode = install_mode(mode, baseline_mode)
            desired = {"sha256": source["sha256"], "mode": mode}

            if current["kind"] == "link":
                raise SyncError("destination is a symlink: {}".format(destination))
            elif current["kind"] == "missing":
                if previous is not None:
                    raise SyncError("locally deleted: {}".format(destination))
                action = "INSTALL"
            elif file_record(current) == desired:
                action = "KEEP" if previous == desired else "ADOPT"
            elif previous == file_record(current):
                action = "UPDATE"
            else:
                action = "CONFLICT"
                conflicts.append("locally edited or unmanaged file differs: {}".format(destination))

            operations.append({
                "source": relative, "destination": destination, "before": current,
                "source_before": source,
                "record": desired, "contents": contents, "old_contents": old_contents,
                "action": action,
            })
        except SyncError as error:
            conflicts.append(str(error))
    return operations, conflicts, sorted(set(state["files"]) - destinations)


def use_color(mode):
    if mode == "always":
        return True
    if mode == "never":
        return False
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"


def page_report(report):
    if not report:
        return
    if sys.stdout.isatty() and os.environ.get("TERM") != "dumb":
        try:
            pager = shlex.split(os.environ.get("PAGER", "less -FRX"))
            if pager and shutil.which(pager[0]):
                sys.stdout.flush()
                result = subprocess.run(pager, input=report, text=True)
                if result.returncode == 0:
                    return
                print("Pager failed; printing diff directly.", file=sys.stderr)
        except (OSError, ValueError):
            print("Could not start pager; printing diff directly.", file=sys.stderr)
    print(report, end="")


def show_diff_plan(operations, conflicts, removed, color):
    delta = shutil.which("delta") if color and sys.stdout.isatty() else None
    if delta:
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            show_plan(operations, conflicts, removed, True)
        report = output.getvalue()
        if not report:
            return
        sys.stdout.flush()
        try:
            result = subprocess.run(
                [delta, "--color-only"], input=report, text=True,
            )
            if result.returncode == 0:
                return
        except OSError:
            pass
        print("Could not render diff with delta; using built-in output.", file=sys.stderr)
    output = io.StringIO()
    with contextlib.redirect_stdout(output):
        show_plan(operations, conflicts, removed, True, color)
    page_report(output.getvalue())


def show_plan(operations, conflicts, removed, show_diff, color=False):
    for operation in operations:
        action, destination = operation["action"], operation["destination"]
        if action != "KEEP":
            print("{} {}".format(action, destination))
        old = operation["old_contents"]
        new = operation["contents"]
        if show_diff and action in ("INSTALL", "UPDATE", "CONFLICT") and old != new:
            try:
                old_text = (old or b"").decode("utf-8")
                new_text = new.decode("utf-8")
                if "\0" in old_text or "\0" in new_text:
                    raise UnicodeError()
                for index, line in enumerate(difflib.unified_diff(
                    old_text.splitlines(keepends=True), new_text.splitlines(keepends=True),
                    fromfile="installed/" + destination, tofile="repository/" + operation["source"],
                )):
                    style = ("1" if index < 2 else "36" if line.startswith("@@")
                             else "32" if line.startswith("+") else "31" if line.startswith("-") else None)
                    rendered = line[:-1] if line.endswith("\n") else line
                    if color and style:
                        rendered = "\033[{}m{}\033[0m".format(style, rendered)
                    print(rendered)
                    if not line.endswith("\n"):
                        print("\\ No newline at end of file")
            except UnicodeError:
                print("  Binary contents differ.")
        if action in ("UPDATE", "CONFLICT") and operation["before"]["mode"] != operation["record"]["mode"]:
            print("  mode {:03o} -> {:03o}".format(
                operation["before"]["mode"], operation["record"]["mode"]))
    for relative in removed:
        print("NO LONGER SELECTED (left installed) {}".format(relative))
    if removed:
        print("Run configs prune --dry-run to preview obsolete-file cleanup.")
    content_conflicts = {"locally edited or unmanaged file differs: " + operation["destination"]
                         for operation in operations if operation["action"] == "CONFLICT"}
    for conflict in conflicts:
        if conflict not in content_conflicts:
            print("CONFLICT " + conflict)


def make_parents(root, relative):
    check_parents(root, relative)
    current = root
    for part in PurePosixPath(relative).parts[:-1]:
        current = current / part
        try:
            current.mkdir(mode=0o700)
        except FileExistsError:
            if current.is_symlink() or not current.is_dir():
                raise SyncError("unsafe parent directory: {}".format(current))


@contextlib.contextmanager
def atomic_file(path, mode):
    fd, temporary = tempfile.mkstemp(prefix=".configs-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            yield stream
            stream.flush()
            os.fchmod(stream.fileno(), mode)
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.lexists(temporary):
            os.unlink(temporary)


def atomic_write(root, relative, contents, mode):
    make_parents(root, relative)
    with atomic_file(root / relative, mode) as stream:
        stream.write(contents)


def save_state(target, state):
    contents = (json.dumps(state, indent=2, sort_keys=True) + "\n").encode("utf-8")
    atomic_write(target, STATE_PATH, contents, 0o600)


def apply_plan(repository, target, state, operations):
    if any(operation["action"] == "CONFLICT" for operation in operations):
        raise SyncError("cannot apply a plan with conflicts")
    dirty = state["repository"] != str(repository)
    state["repository"] = str(repository)
    for operation in operations:
        destination = operation["destination"]
        current, _ = inspect(target, destination)
        if current != operation["before"]:
            raise SyncError("destination changed during apply: {}".format(destination))
        if operation["action"] in ("INSTALL", "UPDATE"):
            atomic_write(target, destination, operation["contents"], operation["record"]["mode"])
        dirty = dirty or state["files"].get(destination) != operation["record"]
        state["files"][destination] = operation["record"]
        # Record each successful file. A crash before this write is recoverable
        # by adopting the matching destination on the next run.
        if dirty:
            save_state(target, state)
            dirty = False
    if dirty:
        save_state(target, state)


MERGE_MARKERS = (b"<<<<<<< configs installed", b"======= configs separator",
                 b">>>>>>> configs repository")


def merge_contents(operation):
    old, new = operation["old_contents"], operation["contents"]
    try:
        old.decode("utf-8")
        new.decode("utf-8")
        if b"\0" in old or b"\0" in new:
            raise UnicodeError()
    except UnicodeError as error:
        raise SyncError("binary contents cannot be merged; choose a side") from error
    editor = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi")
    if not editor:
        raise SyncError("editor command is empty")
    with tempfile.TemporaryDirectory(prefix="configs-merge-") as directory:
        root = Path(directory)
        relative = Path(operation["destination"]).name
        contents = (MERGE_MARKERS[0] + b"\n" + old + (b"" if old.endswith(b"\n") else b"\n")
                    + MERGE_MARKERS[1] + b"\n" + new + (b"" if new.endswith(b"\n") else b"\n")
                    + MERGE_MARKERS[2] + b"\n")
        atomic_write(root, relative, contents, 0o600)
        subprocess.run(editor + [str(root / relative)], check=True)
        snapshot, contents = inspect(root, relative)
        if snapshot["kind"] != "file":
            raise SyncError("merge result must be a regular file")
        try:
            contents.decode("utf-8")
            if b"\0" in contents:
                raise UnicodeError()
        except UnicodeError as error:
            raise SyncError("merge result must be UTF-8 text") from error
        if any(marker in contents for marker in MERGE_MARKERS):
            raise SyncError("merge markers remain; resolution was not saved")
        if input("Save merged contents to repository and installed file? [y/N] ").strip().lower() != "y":
            return None
        return contents


def save_resolution(repository, target, state, operation, contents, mode, keep_installed_mode=False):
    relative = operation["destination"]
    source, _ = inspect(repository, operation["source"])
    current, _ = inspect(target, relative)
    if source != operation["source_before"] or current != operation["before"]:
        raise SyncError("file changed during resolution: {}".format(relative))
    # Write the checkout first. If the installed write or state save fails, a
    # retry can detect the conflict or adopt the already matching contents.
    source_mode = source["mode"]
    if keep_installed_mode:
        # Reflect explicitly chosen execute bits in the checkout so the next
        # apply does not undo them. Preserve the checkout's read/write access.
        source_mode = install_mode((source_mode & 0o666) | (mode & 0o111), source_mode)
        mode = install_mode(source_mode, mode)
    if contents != operation["contents"] or source_mode != source["mode"]:
        atomic_write(repository, operation["source"], contents, source_mode)
    if contents != operation["old_contents"] or mode != current["mode"]:
        atomic_write(target, relative, contents, mode)
    state["repository"] = str(repository)
    state["files"][relative] = {"sha256": digest(contents), "mode": mode}
    save_state(target, state)


def resolve_plan(repository, target, state, operations, conflicts, paths):
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise SyncError("configs resolve requires an interactive terminal")
    choices = {operation["destination"]: operation for operation in operations
               if operation["action"] == "CONFLICT"}
    for relative in paths:
        if not valid_relative(relative) or relative not in choices:
            raise SyncError("not a resolvable conflict: {}".format(relative))
    selected = list(dict.fromkeys(paths)) if paths else list(choices)
    unresolved = set(choices)
    structural = [conflict for conflict in conflicts
                  if conflict not in {"locally edited or unmanaged file differs: " + path for path in choices}]
    for conflict in structural:
        print("CONFLICT " + conflict)
    for relative in selected:
        operation = choices[relative]
        show_plan([operation], [], [], True, use_color(None))
        try:
            while True:
                choice = input("Choose [r]epository, [i]nstalled, [m]erge, [s]kip, or [q]uit: ").strip().lower()
                if choice in ("q", "quit"):
                    return 1
                if choice in ("s", "skip", ""):
                    break
                if choice in ("r", "repository"):
                    contents, mode = operation["contents"], operation["record"]["mode"]
                elif choice in ("i", "installed"):
                    contents, mode = operation["old_contents"], operation["before"]["mode"]
                elif choice in ("m", "merge"):
                    contents, mode = merge_contents(operation), operation["record"]["mode"]
                    if contents is None:
                        break
                else:
                    print("Choose repository, installed, merge, skip, or quit.")
                    continue
                save_resolution(repository, target, state, operation, contents, mode,
                                keep_installed_mode=choice in ("i", "installed"))
                unresolved.remove(relative)
                print("RESOLVED " + relative)
                break
        except (SyncError, OSError, ValueError, subprocess.CalledProcessError) as error:
            print("CONFLICT {}: {}".format(relative, error), file=sys.stderr)
        except EOFError:
            return 1
    return 1 if unresolved or structural else 0


def same_file(left, right):
    try:
        return left.samefile(right)
    except (FileNotFoundError, NotADirectoryError):
        return False


def check_prune_aliases(destination, active, reserved):
    for path in active:
        if same_file(destination, path):
            raise SyncError("obsolete path aliases an active configuration: {}".format(destination))
    # Parent aliases can also hide a destination inside a protected directory.
    for parent in (destination, *destination.parents):
        if any(same_file(parent, path) for path in reserved):
            raise SyncError("obsolete path aliases repository or installation state: {}".format(destination))


def make_prune_plan(repository, target, state):
    sources = set(tracked_sources(repository))
    if COMMAND_PATH not in sources:
        raise SyncError("the installer requires a tracked .local/bin/configs; "
                        "run git add .local/bin/configs before pruning")
    operations, conflicts = [], []
    active = tuple(target / relative for relative in sorted(sources))
    reserved = (repository, (target / STATE_PATH).parent)
    for relative in sorted(set(state["files"]) - sources):
        try:
            destination = target / relative
            for path in reserved:
                if (destination == path or path in destination.parents
                        or destination in path.parents):
                    raise SyncError("obsolete destination overlaps repository or installation state: {}".format(relative))
            current, _ = inspect(target, relative)
            check_prune_aliases(destination, active, reserved)
            if current["kind"] == "missing":
                action = "FORGET"
            elif current["kind"] == "file" and file_record(current) == state["files"][relative]:
                action = "REMOVE"
            else:
                raise SyncError("obsolete file was locally changed: {}".format(relative))
            operations.append({"destination": relative, "before": current, "action": action,
                               "active": active, "reserved": reserved})
        except (SyncError, OSError) as error:
            conflicts.append(str(error))
    return operations, conflicts


def prune_plan(target, state, operations):
    conflicts = []
    for operation in operations:
        relative = operation["destination"]
        try:
            current, _ = inspect(target, relative)
            if current != operation["before"]:
                raise SyncError("destination changed during prune: {}".format(relative))
            check_prune_aliases(target / relative, operation["active"], operation["reserved"])
        except (SyncError, OSError) as error:
            conflicts.append(str(error))
            continue
        if operation["action"] == "REMOVE":
            (target / relative).unlink()
        if relative in state["files"]:
            del state["files"][relative]
            # Delete first: if saving fails, a retry can forget the missing file.
            save_state(target, state)
        print("{} {}".format(operation["action"], relative))
    return conflicts


@contextlib.contextmanager
def installation_lock(target):
    # Lock the existing home directory without creating a lock file, including
    # for diff. This also excludes installers from other repository checkouts.
    fd = os.open(target, os.O_RDONLY)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise SyncError("another installer is using {}".format(target)) from error
        yield
    finally:
        os.close(fd)


def find_repository(script, target):
    candidate = script.parents[2]
    # Installed copies use state even when the home/target is a Git repository.
    if candidate not in (target, Path.home().resolve()) and (candidate / ".git").exists():
        repository = candidate
    else:
        location = load_state(target)["repository"]
        if not location:
            raise SyncError("no saved repository")
        repository = Path(location)
    check_parents(repository, COMMAND_PATH)
    if (not (repository / ".git").exists()
            or not (repository / COMMAND_PATH).is_file()
            or (repository / COMMAND_PATH).is_symlink()):
        raise SyncError("repository moved or configs command is missing")
    result = subprocess.run(
        ["git", "-C", str(repository), "rev-parse", "--show-toplevel"],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    if Path(os.fsdecode(result.stdout).rstrip("\n")).resolve() != repository.resolve():
        raise SyncError("saved location is not a repository root")
    return repository.resolve()


def run_checkout(repository, *arguments):
    # Keep our buffered output ahead of the child's when stdout is a pipe.
    sys.stdout.flush()
    return subprocess.run([sys.executable, str(repository / COMMAND_PATH), *arguments]).returncode


def update_zgenom(target):
    """Update zgenom and its plugins when it is installed in the target."""
    script = target / ".zgenom/zgenom.zsh"
    zsh = shutil.which("zsh")
    if zsh is None or not script.is_file():
        return 0
    result = subprocess.run([zsh, "-c", 'source "$1" && zgenom selfupdate && zgenom update', "zsh", str(script)])
    if result.returncode:
        print("Configuration applied, but updating zgenom plugins failed. Rerun configs update.", file=sys.stderr)
    return result.returncode


def git_output(repository, *arguments, check=True):
    result = subprocess.run(["git", "-C", str(repository), *arguments],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)
    return os.fsdecode(result.stdout).strip() if result.returncode == 0 else None


def download(url):
    limit = 64 * 1024 * 1024
    with urllib.request.urlopen(url, timeout=60) as response:
        data = response.read(limit + 1)
    if len(data) > limit:
        raise SyncError("download exceeds {} bytes: {}".format(limit, url))
    return data


def gitstatus_release(install_info, platform):
    """Select a gitstatusd release the way gitstatus/install matches uname."""
    kernel, machine = platform.split("-", 1)
    for line in install_info.splitlines():
        if line.lstrip().startswith("#"):
            continue
        fields = dict(re.findall(r'(\w+)="([^"]*)"', line))
        if not fields:
            continue
        if not {"uname_s_glob", "uname_m_glob", "file", "version", "sha256"} <= set(fields):
            raise SyncError("invalid gitstatus install.info line: {}".format(line))
        if (fnmatch.fnmatchcase(kernel, fields["uname_s_glob"])
                and fnmatch.fnmatchcase(machine, fields["uname_m_glob"])):
            name = fields["file"].replace("${uname_s}", kernel).replace("${uname_m}", machine)
            if (not re.fullmatch(r"gitstatusd-[a-z0-9_.-]+", name)
                    or not re.fullmatch(r"v[0-9][0-9.]*", fields["version"])
                    or not re.fullmatch(r"[0-9a-f]{64}", fields["sha256"])):
                raise SyncError("invalid gitstatus install.info line: {}".format(line))
            return name, fields["version"], fields["sha256"]
    raise SyncError("no gitstatusd release for {}".format(platform))


def add_gitstatus(zgenom, platforms):
    """Bundle gitstatusd where powerlevel10k looks before trying to download it."""
    directories = sorted(path.parent for path in (zgenom / "sources").rglob("install.info")
                         if path.parent.name == "gitstatus" and path.is_file() and not path.is_symlink())
    if not directories:
        print("NOTE no gitstatus found in zgenom plugins; skipping gitstatusd", file=sys.stderr)
        return
    downloads = {}
    for directory in directories:
        install_info = (directory / "install.info").read_text(encoding="utf-8")
        for platform in platforms:
            name, version, sha256 = gitstatus_release(install_info, platform)
            url = GITSTATUS_URL.format(version=version, file=name)
            if url not in downloads:
                try:
                    data = download(url)
                except OSError as error:
                    raise SyncError("could not download gitstatusd for {}: {}".format(platform, error)) from error
                if digest(data) != sha256:
                    raise SyncError("gitstatusd checksum mismatch for {}: {}".format(platform, url))
                try:
                    with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as archive:
                        member = archive.getmember(name)
                        if not member.isfile():
                            raise SyncError("gitstatusd archive entry is not a file: {}".format(url))
                        downloads[url] = archive.extractfile(member).read()
                except (tarfile.TarError, KeyError) as error:
                    raise SyncError("invalid gitstatusd archive {}: {}".format(url, error)) from error
                print("EXPORT gitstatusd {} {}".format(platform, version))
            usrbin = directory / "usrbin"
            usrbin.mkdir(exist_ok=True)
            (usrbin / name).write_bytes(downloads[url])
            (usrbin / name).chmod(0o755)


def without_credentials(url):
    """Keep a remote URL usable elsewhere without copying passwords or tokens."""
    parts = urllib.parse.urlsplit(url)
    if "@" not in parts.netloc:
        return url
    userinfo, host = parts.netloc.rsplit("@", 1)
    if parts.scheme in ("http", "https"):
        netloc = host
    elif ":" in userinfo:
        netloc = userinfo.split(":", 1)[0] + "@" + host
    else:
        return url
    return urllib.parse.urlunsplit(parts._replace(netloc=netloc))


def write_archive(root, archive):
    def normalize(info):
        info.uid = info.gid = 0
        info.uname = info.gname = ""
        return info

    archive = Path(os.path.abspath(archive))
    with atomic_file(archive, 0o600) as stream:
        with tarfile.open(fileobj=stream, mode="w:gz") as output:
            output.add(str(root), arcname=EXPORT_ROOT, filter=normalize)
    return archive


def export_archive(repository, target, archive, platforms):
    branch = git_output(repository, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    if not branch:
        raise SyncError("export requires a checked-out branch")
    commit = git_output(repository, "rev-parse", "HEAD")
    if git_output(repository, "status", "--porcelain", "--untracked-files=no"):
        print("WARNING uncommitted changes are not exported; commit them first to include them", file=sys.stderr)
    try:
        relative = repository.relative_to(target).as_posix()
    except ValueError:
        relative = None
    with tempfile.TemporaryDirectory(prefix="configs-export-") as directory:
        root = Path(directory) / EXPORT_ROOT
        root.mkdir()
        git_output(repository, "bundle", "create", "--quiet", str(root / "repository.bundle"), "refs/heads/" + branch)
        print("EXPORT repository {} {}".format(branch, commit[:12]))
        # Match the bundle rather than any uncommitted edits to the installer.
        (root / "configs").write_bytes(subprocess.run(
            ["git", "-C", str(repository), "show", "{}:{}".format(commit, COMMAND_PATH)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True).stdout)
        (root / "configs").chmod(0o755)
        zgenom = target / ".zgenom"

        def ignore(directory, names):
            # init.zsh holds absolute paths and .zwc files are compiled for one zsh;
            # zgenom regenerates both offline because every plugin is present.
            ignored = {name for name in names if name.endswith(".zwc")}
            if Path(directory) == zgenom / "sources":
                ignored.update(name for name in names if name == "init.zsh" or name.startswith("zcompdump"))
            return ignored

        if zgenom.is_dir() and not zgenom.is_symlink():
            shutil.copytree(zgenom, root / "zgenom", symlinks=True, ignore=ignore)
            print("EXPORT zgenom")
            add_gitstatus(root / "zgenom", platforms)
        else:
            print("NOTE {} not found; exporting without zsh plugins".format(zgenom), file=sys.stderr)
        origin = git_output(repository, "config", "--get", "remote.origin.url", check=False)
        manifest = {
            "format": EXPORT_FORMAT, "branch": branch, "repository": relative,
            "origin": without_credentials(origin) if origin else None,
        }
        (root / "manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        try:
            check_entries(staged_entries(root))
        except SyncError as error:
            raise SyncError("cannot export an archive that import would reject: {}".format(error)) from error
        archive = write_archive(root, archive)
    print("Wrote {}".format(archive))
    print("On the other machine: tar xzf {} && python3 {}/configs import".format(
        shlex.quote(archive.name), EXPORT_ROOT))


def through_link(path, links):
    """Whether a lexical path walks through one of the archive's own links."""
    current = ""
    for part in PurePosixPath(path).parts[:-1]:
        current = posixpath.normpath(posixpath.join(current, part))
        if current in links:
            return True
    return False


def check_entries(entries):
    """Accept only files, directories, and links that stay inside their part of the export.

    Links must stay within their top-level directory (e.g. zgenom/), which is
    installed on its own. They are checked lexically, so nothing may be written
    or resolved through another link: extraction without tarfile's data filter
    would follow it.
    """
    entries = list(entries)
    names = [name for name, _, _ in entries]
    if len(set(names)) != len(names):
        raise SyncError("duplicate archive entry")
    links = {name for name, kind, _ in entries if kind == "link"}
    for name, kind, link in entries:
        if (not valid_relative(name) or name.split("/", 1)[0] != EXPORT_ROOT
                or through_link(name, links)):
            raise SyncError("unsafe archive entry: {}".format(name))
        if kind == "link":
            target = posixpath.join(posixpath.dirname(name), link)
            scope = "/".join(name.split("/")[:2]) + "/"
            if not posixpath.normpath(target).startswith(scope) or through_link(target, links):
                raise SyncError("unsafe archive link: {} -> {}".format(name, link))
        elif kind not in ("file", "dir"):
            raise SyncError("unsupported archive entry: {}".format(name))


def member_entry(member):
    kind = "link" if member.issym() else "dir" if member.isdir() else "file" if member.isfile() else "other"
    return member.name, kind, member.linkname if kind == "link" else None


def staged_entries(root):
    for directory, directories, files in os.walk(str(root)):
        for name in directories + files:
            path = os.path.join(directory, name)
            mode = os.lstat(path).st_mode
            kind = ("link" if stat.S_ISLNK(mode) else "dir" if stat.S_ISDIR(mode)
                    else "file" if stat.S_ISREG(mode) else "other")
            relative = posixpath.join(EXPORT_ROOT, *Path(os.path.relpath(path, str(root))).parts)
            yield relative, kind, os.readlink(path) if kind == "link" else None


def extract_archive(archive, directory):
    # tarfile stops at the end-of-archive marker before gzip's trailing CRC, so
    # read the stream once to detect a truncated or corrupted transfer.
    try:
        with gzip.open(str(archive)) as stream:
            while stream.read(1024 * 1024):
                pass
    except (OSError, EOFError, zlib.error) as error:
        raise SyncError("invalid export archive {} (incomplete or corrupted transfer?): {}".format(
            archive, error)) from error
    try:
        with tarfile.open(str(archive), mode="r:gz") as source:
            members = source.getmembers()
            check_entries(member_entry(member) for member in members)
            if hasattr(tarfile, "data_filter"):
                source.extractall(directory, members=members, filter="data")
            else:
                source.extractall(directory, members=members)
    except tarfile.TarError as error:
        raise SyncError("invalid export archive {}: {}".format(archive, error)) from error
    return Path(directory) / EXPORT_ROOT


def load_manifest(export):
    try:
        manifest = json.loads((export / "manifest.json").read_text(encoding="utf-8"))
        if not isinstance(manifest, dict) or manifest.get("format") != EXPORT_FORMAT:
            raise ValueError("unsupported export format; export again with this configs version")
        branch = manifest.get("branch")
        if not isinstance(branch, str) or not branch or branch.startswith("-"):
            raise ValueError("invalid branch")
        if manifest.get("repository") is not None and not valid_relative(manifest["repository"]):
            raise ValueError("invalid repository location")
        if manifest.get("origin") is not None and not isinstance(manifest["origin"], str):
            raise ValueError("invalid origin")
        if not (export / "repository.bundle").is_file():
            raise ValueError("repository bundle is missing")
        return manifest
    except (OSError, ValueError, UnicodeError) as error:
        raise SyncError("invalid export {}: {}".format(export, error)) from error


def import_repository(export, manifest, destination):
    bundle, branch = str(export / "repository.bundle"), manifest["branch"]
    if os.path.lexists(destination):
        if not (destination / ".git").exists():
            raise SyncError("repository destination exists but is not a Git checkout: {}".format(destination))
        current = git_output(destination, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
        if current != branch:
            raise SyncError("checkout {} is on {}, but the export is from {}".format(destination, current, branch))
        subprocess.run(["git", "-C", str(destination), "pull", "--ff-only", "--quiet", bundle, branch], check=True)
    else:
        destination.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "clone", "--quiet", "--branch", branch, bundle, str(destination)], check=True)
        # Keep the original remote so git pull works if the machine is ever online.
        if manifest.get("origin"):
            subprocess.run(["git", "-C", str(destination), "remote", "set-url", "origin", manifest["origin"]], check=True)
        else:
            subprocess.run(["git", "-C", str(destination), "remote", "remove", "origin"], check=True)
    print("IMPORT repository {} {} into {}".format(
        branch, git_output(destination, "rev-parse", "--short=12", "HEAD"), destination))


def remove_tree(path):
    if path.is_symlink() or not path.is_dir():
        path.unlink()
    else:
        shutil.rmtree(path)


def import_zgenom(source, target):
    destination = target / ".zgenom"
    if destination.is_symlink() or (destination.exists() and not destination.is_dir()):
        raise SyncError("not a directory: {}".format(destination))
    staging, previous = target / ".zgenom.import", target / ".zgenom.previous"
    if os.path.lexists(staging):
        remove_tree(staging)
    shutil.copytree(source, staging, symlinks=True)
    # The old copy stays in place until the new one is complete.
    if os.path.lexists(previous):
        remove_tree(previous)
    if destination.exists():
        os.rename(destination, previous)
    os.rename(staging, destination)
    if os.path.lexists(previous):
        remove_tree(previous)
    print("IMPORT zgenom into {}".format(destination))
    if os.path.lexists(target / ".zgen"):
        print("WARNING zgenom keeps plugins in {} while it exists; remove it to use the imported plugins".format(
            target / ".zgen"), file=sys.stderr)


def import_archive(script, target, source, repository):
    with tempfile.TemporaryDirectory(prefix="configs-import-") as directory:
        if source is None:
            export = script.parent
            if not (export / "manifest.json").is_file():
                raise SyncError("pass the export archive or its extracted {} directory".format(EXPORT_ROOT))
        elif source.is_dir():
            export = source if (source / "manifest.json").exists() else source / EXPORT_ROOT
        else:
            export = extract_archive(source, directory)
        manifest = load_manifest(export)
        if repository is not None:
            destination = Path(os.path.abspath(repository.expanduser()))
        elif manifest.get("repository") is not None:
            destination = target / manifest["repository"]
        else:
            raise SyncError("the exported repository was outside the home directory; pass --repository")
        import_repository(export, manifest, destination)
        result = run_checkout(destination, "apply", "--target", str(target))
        if result:
            print("Repository imported, but configuration application failed. Resolve the error, "
                  "rerun configs apply, then import again to install zsh plugins.", file=sys.stderr)
            return result
        if (export / "zgenom").is_dir():
            with installation_lock(target):
                import_zgenom(export / "zgenom", target)
    print("Configuration imported. Start a new shell to load it.")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("diff", "apply", "update", "repo", "prune", "resolve", "export", "import"))
    parser.add_argument("paths", nargs="*",
                        help="repository-relative conflicts to resolve, or the archive to export or import")
    parser.add_argument("--target", type=Path, default=Path.home(), help="existing home directory to install into")
    parser.add_argument("--dry-run", action="store_true", help="preview prune without deleting files or changing state")
    parser.add_argument("--color", choices=("auto", "always", "never"),
                        help="color diff output (default: auto; respects NO_COLOR and TERM=dumb)")
    parser.add_argument("--platform", action="append",
                        help="OS-ARCH to bundle gitstatusd for, repeatable (export only; default: {})".format(
                            ", ".join(DEFAULT_PLATFORMS)))
    parser.add_argument("--repository", type=Path,
                        help="checkout location (import only; default: the exported location under the target)")
    args = parser.parse_intermixed_args()
    if args.paths and args.command not in ("resolve", "export", "import"):
        parser.error("paths are only supported for resolve, export, and import")
    if len(args.paths) > 1 and args.command in ("export", "import"):
        parser.error("{} takes at most one archive".format(args.command))
    if args.dry_run and args.command != "prune":
        parser.error("--dry-run is only supported for prune")
    if args.color is not None and args.command != "diff":
        parser.error("--color is only supported for diff")
    if args.platform is not None and args.command != "export":
        parser.error("--platform is only supported for export")
    if any(not re.fullmatch(r"[a-z0-9_]+-[a-z0-9_]+", platform) for platform in args.platform or ()):
        parser.error("--platform must look like linux-x86_64")
    if args.repository is not None and args.command != "import":
        parser.error("--repository is only supported for import")
    script = Path(__file__).resolve()
    target = Path(os.path.abspath(args.target.expanduser()))
    try:
        if target.is_symlink() or not target.is_dir():
            raise SyncError("target must be an existing, non-symlink directory")
        target = target.resolve()
        if args.command == "import":
            # Import runs before any checkout or state exists on a new machine.
            return import_archive(script, target, Path(args.paths[0]) if args.paths else None, args.repository)
        try:
            repository = find_repository(script, target)
        except (SyncError, OSError, subprocess.CalledProcessError) as error:
            raise SyncError("{}. Run python3 /path/to/configs/.local/bin/configs apply.".format(error)) from error
        if target == repository or repository in target.parents:
            raise SyncError("target must not be inside the repository")
        if repository in (target / STATE_PATH).parents:
            raise SyncError("installation state would overlap the repository")
        if script != repository / COMMAND_PATH:
            # The checkout runs with the same working directory, so relative paths still resolve.
            return run_checkout(repository, *sys.argv[1:])
        if args.command == "export":
            export_archive(repository, target, Path(args.paths[0]) if args.paths else Path(DEFAULT_ARCHIVE),
                           args.platform or DEFAULT_PLATFORMS)
            return 0
        with installation_lock(target):
            state = load_state(target)
            if args.command == "repo":
                print(repository)
                return 0
            if args.command == "prune":
                show_checkout_changes(repository)
                operations, conflicts = make_prune_plan(repository, target, state)
                if args.dry_run:
                    for operation in operations:
                        print("WOULD {} {}".format(operation["action"], operation["destination"]))
                else:
                    conflicts.extend(prune_plan(target, state, operations))
                for conflict in conflicts:
                    print("CONFLICT " + conflict)
                return 1 if conflicts else 0
            if args.command == "update":
                subprocess.run(["git", "pull", "--ff-only"], cwd=repository, check=True)
            else:
                show_checkout_changes(repository)
                operations, conflicts, removed = make_plan(repository, target, state)
                if args.command == "resolve":
                    return resolve_plan(repository, target, state, operations, conflicts, args.paths)
                if args.command == "diff":
                    show_diff_plan(operations, conflicts, removed, use_color(args.color))
                else:
                    show_plan(operations, conflicts, removed, False)
                if conflicts:
                    print("Run configs resolve to choose or merge conflicting files; fix structural errors manually. "
                          "No files were changed.", file=sys.stderr)
                    return 1
                if args.command == "apply":
                    apply_plan(repository, target, state, operations)
                    print("Configuration applied.")
        if args.command == "update":
            result = run_checkout(repository, "apply", "--target", str(target))
            if result:
                print("Repository updated, but configuration application failed. Resolve the error and rerun configs apply.",
                      file=sys.stderr)
                return result
            return update_zgenom(target)
        return 0
    except (SyncError, OSError, subprocess.CalledProcessError) as error:
        print("configs: {}".format(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nResolution interrupted.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())

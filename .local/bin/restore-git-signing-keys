#!/usr/bin/env bash

set -euo pipefail

public_key=${RESTORE_SSH_PUBLIC_KEY:-"$HOME/.ssh/id_ed25519_sk_git.pub"}
private_key=${RESTORE_SSH_PRIVATE_KEY:-"$HOME/.ssh/id_ed25519_sk_git"}
gpg_public_key=${RESTORE_GPG_PUBLIC_KEY:-"$HOME/.gnupg/work-git-signing-key.asc"}
gpg_key_fingerprint=${RESTORE_GPG_KEY_FINGERPRINT:-"00940AB35C1932E4AFBACFE81603DAD8C3DD2A0D"}
temporary_file=
staging_directory=
ssh_keygen_command=
gpg_command=
restore_ssh_key=true

usage() {
  cat <<'EOF'
Usage: restore-git-signing-key

Restore Git signing keys from an attached YubiKey:

* the OpenPGP work key whose public certificate is stored in this dotfiles repo;
* the resident FIDO SSH key matching ~/.ssh/id_ed25519_sk_git.pub.

The OpenPGP private key remains on the YubiKey. This command imports only its
public certificate and creates local GnuPG card references.

Environment overrides:
  RESTORE_SSH_PUBLIC_KEY   Expected public key
  RESTORE_SSH_PRIVATE_KEY  Destination for the restored key handle
  RESTORE_GPG_PUBLIC_KEY   Work OpenPGP public certificate
  RESTORE_GPG_KEY_FINGERPRINT
                           Expected primary OpenPGP key fingerprint
EOF
}

cleanup() {
  if [[ -n "$temporary_file" && "$temporary_file" == "$private_key.restore-"* ]]; then
    rm -f "$temporary_file"
  fi

  if [[ -n "$staging_directory" && -d "$staging_directory" ]]; then
    rm -rf "$staging_directory"
  fi
}

ssh_fingerprint() {
  local output

  output=$("$ssh_keygen_command" -lf "$1") || return 1
  awk 'NR == 1 { print $2 }' <<< "$output"
}

gpg_primary_fingerprint() {
  "$gpg_command" --batch --with-colons --show-keys "$1" |
    awk -F: '$1 == "pub" { expect_fingerprint = 1; next }
              expect_fingerprint && $1 == "fpr" {
                print $10
                expect_fingerprint = 0
              }'
}

gpg_card_signing_fingerprint() {
  awk -F: '$1 == "fpr" { print $10; exit }'
}

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  usage
  exit 0
fi

if [[ $# -ne 0 ]]; then
  usage >&2
  exit 2
fi

for command in awk mktemp gpg; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "restore-git-signing-key: $command is required" >&2
    exit 1
  fi
done

ssh_keygen_command=$(command -v ssh-keygen || true)
if [[ -z "$ssh_keygen_command" ]]; then
  echo "restore-git-signing-key: ssh-keygen is required" >&2
  exit 1
fi

gpg_command=$(command -v gpg)

# Apple's /usr/bin/ssh-keygen does not include the FIDO provider needed for
# resident-key downloads. Prefer Homebrew OpenSSH when it is available.
if [[ $(uname -s) == Darwin ]]; then
  homebrew_ssh_keygen=
  if command -v brew >/dev/null 2>&1; then
    brew_prefix=$(brew --prefix openssh 2>/dev/null || true)
    if [[ -n "$brew_prefix" && -x "$brew_prefix/bin/ssh-keygen" ]]; then
      homebrew_ssh_keygen="$brew_prefix/bin/ssh-keygen"
    fi
  fi
  if [[ -z "$homebrew_ssh_keygen" ]]; then
    for candidate in \
      /opt/homebrew/opt/openssh/bin/ssh-keygen \
      /usr/local/opt/openssh/bin/ssh-keygen \
      /opt/homebrew/bin/ssh-keygen \
      /usr/local/bin/ssh-keygen
    do
      if [[ -x "$candidate" ]]; then
        homebrew_ssh_keygen=$candidate
        break
      fi
    done
  fi
  if [[ -n "$homebrew_ssh_keygen" ]]; then
    ssh_keygen_command=$homebrew_ssh_keygen
  fi
fi

if [[ ! -f "$public_key" && ! -e "$private_key" && ! -L "$private_key" ]]; then
  echo "restore-git-signing-key: expected public key not found: $public_key" >&2
  echo "Run the dotfiles setup before restoring the resident key." >&2
  exit 1
fi

if [[ ! -f "$gpg_public_key" ]]; then
  echo "restore-git-signing-key: expected GPG public key not found: $gpg_public_key" >&2
  echo "Run the dotfiles setup before restoring the work GPG key." >&2
  exit 1
fi

if [[ -e "$private_key" || -L "$private_key" ]]; then
  restore_ssh_key=false
  echo "restore-git-signing-key: destination already exists; skipping resident SSH key restore: $private_key" >&2
fi

gpg_public_key_fingerprint=$(gpg_primary_fingerprint "$gpg_public_key")
if [[ "$gpg_public_key_fingerprint" == *$'\n'* || "$gpg_public_key_fingerprint" != "$gpg_key_fingerprint" ]]; then
  echo "restore-git-signing-key: invalid or unexpected GPG public key: $gpg_public_key" >&2
  echo "Expected fingerprint: $gpg_key_fingerprint" >&2
  exit 1
fi

echo "Importing work GPG public key..."
"$gpg_command" --batch --import "$gpg_public_key"

echo "Creating GnuPG card references from the attached YubiKey..."
if ! card_status=$("$gpg_command" --batch --with-colons --card-status); then
  echo "restore-git-signing-key: unable to access the OpenPGP application on the YubiKey" >&2
  exit 1
fi

card_signing_fingerprint=$(gpg_card_signing_fingerprint <<< "$card_status")
if [[ "$card_signing_fingerprint" != "$gpg_key_fingerprint" ]]; then
  echo "restore-git-signing-key: the attached YubiKey does not contain the expected GPG signing key" >&2
  echo "Expected fingerprint: $gpg_key_fingerprint" >&2
  echo "Card signing fingerprint: ${card_signing_fingerprint:-none}" >&2
  exit 1
fi

echo "Restored work GPG key: $gpg_key_fingerprint"

if [[ "$restore_ssh_key" == false ]]; then
  exit 0
fi

expected_fingerprint=$(ssh_fingerprint "$public_key") || {
  echo "restore-git-signing-key: invalid public key: $public_key" >&2
  exit 1
}

temporary_root=${TMPDIR:-/tmp}
temporary_root=${temporary_root%/}
[[ -n "$temporary_root" ]] || temporary_root=/tmp
staging_directory=$(mktemp -d "$temporary_root/restore-git-signing-key.XXXXXX")
trap cleanup EXIT

echo "Downloading resident SSH keys from the attached authenticator..."
if ! (cd "$staging_directory" && "$ssh_keygen_command" -K); then
  echo "restore-git-signing-key: unable to download resident SSH keys" >&2
  if [[ $(uname -s) == Darwin && "$ssh_keygen_command" == /usr/bin/ssh-keygen ]]; then
    echo "macOS's bundled ssh-keygen lacks FIDO support; install Homebrew OpenSSH with: brew install openssh" >&2
  fi
  exit 1
fi

shopt -s nullglob
recovered_public_keys=("$staging_directory"/*.pub)
matching_private_key=
match_count=0

for recovered_public_key in "${recovered_public_keys[@]}"; do
  recovered_private_key=${recovered_public_key%.pub}
  [[ -f "$recovered_private_key" ]] || continue

  recovered_fingerprint=$(ssh_fingerprint "$recovered_public_key") || continue
  if [[ "$recovered_fingerprint" == "$expected_fingerprint" ]]; then
    matching_private_key=$recovered_private_key
    match_count=$((match_count + 1))
  fi
done

if [[ $match_count -eq 0 ]]; then
  echo "restore-git-signing-key: the expected resident key was not found" >&2
  echo "Expected fingerprint: $expected_fingerprint" >&2
  exit 1
fi

if [[ $match_count -ne 1 ]]; then
  echo "restore-git-signing-key: multiple resident keys matched $expected_fingerprint" >&2
  exit 1
fi

private_key_directory=${private_key%/*}
if [[ "$private_key_directory" == "$private_key" ]]; then
  private_key_directory=.
fi

mkdir -p "$private_key_directory"
chmod 700 "$private_key_directory"

temporary_file="$private_key.restore-$$"
umask 077
cp "$matching_private_key" "$temporary_file"
chmod 600 "$temporary_file"
mv "$temporary_file" "$private_key"
temporary_file=

echo "Restored resident key handle: $private_key"
echo "Fingerprint: $expected_fingerprint"

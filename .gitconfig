[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[diff]
	algorithm = histogram
	colorMoved = default
[user]
	email = mail@sakumatti.fi
	name = Sakumatti Luukkonen
	signingKey = ~/.ssh/id_ed25519_sk_git
[gpg]
	format = ssh
[gpg "ssh"]
	program = ~/.local/bin/git-ssh-keygen
	allowedSignersFile = ~/.ssh/allowed_signers
[push]
	default = current
	autoSetupRemote = true
[sequence]
	editor = interactive-rebase-tool
[includeIf "gitdir:~/Work/**"]
	path = .gitconfig_work
[core]
	editor = vim -f
	pager = delta
	excludesFile = ~/.gitignore_global
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = ansi
	navigate = true
[pull]
	ff = only
[commit]
	gpgsign = true
[rebase]
	autosquash = true
	updateRefs = true
	autoStash = true
[alias]
	commit-reuse = commit -eF .git/COMMIT_EDITMSG
	wt = "!f() { git fetch origin && base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) && git worktree add -b \"$1\" \"../${1//\\//-}\" \"$base\"; }; f"
[init]
	defaultBranch = main
[fetch]
	prune = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[include]
	path = ~/.gitconfig_local
